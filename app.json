{
  "expo": {
    "name": "Drift Sound",
    "slug": "driftsound",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "driftsound",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gigasonet.driftsound"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0C0C12"
      },
      "package": "com.gigasonet.driftsound"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
